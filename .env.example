# Example only. Run pnpm.cmd setup:env to generate an ignored local .env.
# PostgreSQL is published on host port 5434; its container uses port 5432.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DATABASE_URL=postgresql://ark:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5434/ark_dev
# Never prefix a database credential with VITE_: that would expose it to browsers.
